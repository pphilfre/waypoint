# Public: used only to connect the browser to the matching Convex deployment.
VITE_CONVEX_URL=https://YOUR_DEPLOYMENT.convex.cloud

# Server-only WorkOS configuration. Never prefix these with VITE_.
WORKOS_CLIENT_ID=client_YOUR_CLIENT_ID
WORKOS_API_KEY=sk_test_YOUR_KEY
WORKOS_COOKIE_PASSWORD=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
WORKOS_REDIRECT_URI=http://localhost:3000/callback

# Optional Convex CLI target for local development.
CONVEX_DEPLOYMENT=dev:YOUR_DEPLOYMENT
